#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BT0     BT_SEL 0
#define BT1     BT_SEL 1
#define BT2     BT_SEL 2
#define BT3     BT_SEL 3
#define BT4     BT_SEL 4

/ {
    macros {
        caps_macro: caps_macro {
            compatible = "zmk,behavior-macro";
            label = "caps_macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <200>;
            bindings = <&kp CAPS>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHIFT>, <&caps_macro>;
        };

        hl: homerow_layertap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            require-prior-idle-ms = <125>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        to_win {
            bindings = <&to 5>;
            key-positions = <39 40 41>;
        };

        to_mac {
            bindings = <&to 0>;
            key-positions = <27 28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3          &kp N4     &kp N5                                  &kp N6  &kp N7              &kp N8               &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E           &kp R      &kp T                                   &kp Y   &kp U               &kp I                &kp O    &kp P     &kp DELETE
&kp LSHFT  &kp A   &kp S   &kp D           &kp F      &kp G                                   &kp H   &kp J               &kp K                &kp L    &kp SEMI  &kp SQT
&kp LGUI   &kp Z   &kp X   &kp C           &kp V      &kp B   &kp K_MUTE    &kp C_PLAY_PAUSE  &kp N   &kp M               &kp COMMA            &kp DOT  &kp FSLH  &kp RSHFT
                           &lt 3 CAPSLOCK  &kp LCTRL  &mo 1   &kp SPACE     &kp ENTER         &mo 2   &kp RC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)
            >;

            label = "mac";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            bindings = <
&trans     &kp F1     &kp F2       &kp F3    &kp F4          &kp F5                              &kp F6             &kp F7           &kp F8         &kp F9                &kp F10                &kp F11
&kp GRAVE  &kp N1     &kp N2       &kp N3    &kp N4          &kp N5                              &kp N6             &kp N7           &kp N8         &kp N9                &kp N0                 &kp F12
&trans     &kp EXCL   &kp AT_SIGN  &kp HASH  &kp DOLLAR      &kp PERCENT                         &kp CARET          &kp AMPERSAND    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp EQUAL  &kp MINUS    &kp PLUS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &trans    &trans  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp SEMICOLON  &kp COLON             &kp BACKSLASH          &trans
                                   &trans    &trans          &trans            &trans    &trans  &trans             &trans           &trans
            >;

            label = "lower";
        };

        raise_layer {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2        &bt BT_SEL 3  &bt BT_SEL 4                    &trans         &trans      &trans            &trans      &trans  &trans
&bt BT_CLR_ALL  &kp INS       &kp PRINTSCREEN  &kp K_CONTEXT_MENU  &trans        &trans                          &kp PG_UP      &trans      &kp UP_ARROW      &trans      &trans  &trans
&trans          &kp LEFT_ALT  &kp LCTRL        &kp LEFT_SHIFT      &trans        &trans                          &kp PAGE_DOWN  &kp LEFT    &kp DOWN          &kp RIGHT   &trans  &trans
&trans          &kp K_UNDO    &kp K_CUT        &kp K_COPY          &kp K_PASTE   &trans        &trans    &trans  &trans         &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans
                                               &trans              &trans        &trans        &trans    &trans  &trans         &trans      &trans
            >;

            label = "raise";
        };

        adust_layer {
            bindings = <
&trans           &trans           &trans           &trans           &trans           &kp LS(D)                          &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans           &trans           &trans           &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_ON   &rgb_ug RGB_EFF  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI                    &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans           &trans           &trans           &trans    &trans  &trans  &trans  &trans
            >;

            label = "adjust";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        win {
            label = "win";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3          &kp N4        &kp N5                                  &kp N6  &kp N7                  &kp N8                   &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E           &kp R         &kp T                                   &kp Y   &kp U                   &kp I                    &kp O    &kp P     &kp DELETE
&kp LSHFT  &kp A   &kp S   &kp D           &kp F         &kp G                                   &kp H   &kp J                   &kp K                    &kp L    &kp SEMI  &kp SQT
&kp RCTRL  &kp Z   &kp X   &kp C           &kp V         &kp B   &kp K_MUTE    &kp C_PLAY_PAUSE  &kp N   &kp M                   &kp COMMA                &kp DOT  &kp FSLH  &kp RSHFT
                           &lt 8 CAPSLOCK  &kp LEFT_GUI  &mo 6   &kp SPACE     &kp ENTER         &mo 7   &kp RC(RG(LEFT_ARROW))  &kp LC(LG(RIGHT_ARROW))
            >;
        };

        lower_layer_win {
            label = "lower_w";
            bindings = <
&trans     &kp F1     &kp F2       &kp F3    &kp F4          &kp F5                              &kp F6             &kp F7           &kp F8         &kp F9                &kp F10                &kp F11
&kp GRAVE  &kp N1     &kp N2       &kp N3    &kp N4          &kp N5                              &kp N6             &kp N7           &kp N8         &kp N9                &kp N0                 &kp F12
&trans     &kp EXCL   &kp AT_SIGN  &kp HASH  &kp DOLLAR      &kp PERCENT                         &kp CARET          &kp AMPERSAND    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp EQUAL  &kp MINUS    &kp PLUS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &trans    &trans  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp SEMICOLON  &kp COLON             &kp BACKSLASH          &trans
                                   &trans    &trans          &trans            &trans    &trans  &trans             &trans           &trans
            >;
        };

        raise_layer_win {
            label = "raise_w";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2        &bt BT_SEL 3  &bt BT_SEL 4                    &trans         &trans      &trans            &trans      &trans  &trans
&bt BT_CLR_ALL  &kp INS       &kp PRINTSCREEN  &kp K_CONTEXT_MENU  &trans        &trans                          &kp PG_UP      &trans      &kp UP_ARROW      &trans      &trans  &trans
&trans          &kp LEFT_ALT  &kp LCTRL        &kp LEFT_SHIFT      &trans        &trans                          &kp PAGE_DOWN  &kp LEFT    &kp DOWN          &kp RIGHT   &trans  &trans
&trans          &kp K_UNDO    &kp K_CUT        &kp K_COPY          &kp K_PASTE   &trans        &trans    &trans  &trans         &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans
                                               &trans              &trans        &trans        &trans    &trans  &trans         &trans      &trans
            >;
        };

        adjust_layer_win {
            label = "adjust_w";
            bindings = <
&trans           &trans           &trans           &trans           &trans           &kp LS(D)                          &trans  &trans  &trans  &trans  &trans  &trans
&trans           &trans           &trans           &trans           &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_ON   &rgb_ug RGB_EFF  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI                    &trans  &trans  &trans  &trans  &trans  &trans
&rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                   &trans           &trans           &trans           &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
